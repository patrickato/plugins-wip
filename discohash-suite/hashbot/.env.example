# hashbot.py configuration
#
# Copy this file to ".env" in this same folder and fill in every value
# below. ".env" itself should never be committed to git - it's already
# listed in .gitignore.
#
# See ../SETUP.md for exactly how to get each of these values.

# --- Discord bot ---
DISCORD_TOKEN=
HASH_CHANNEL_ID=

# >>> USER INPUT REQUIRED <<<
# Your own Discord user ID - only this user will be able to run any
# command. Enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click your own name and choose "Copy User ID".
AUTHORIZED_USER_ID=

# --- SSH access to your pwnagotchi (for !status/!reboot/!poweroff/etc) ---
PI_SSH_HOST=
PI_SSH_PORT=22
PI_SSH_USER=pi
PI_SSH_KEY_PATH=
PI_HANDSHAKE_DIR=/etc/pwnagotchi/handshakes
