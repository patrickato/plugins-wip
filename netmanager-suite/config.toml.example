# NetManagerNG - add this block to /etc/pwnagotchi/config.toml
#
# Section name is [main.plugins.netmanager_ng], matching the plugin FILE's
# basename (netmanager_ng.py). This fork's loader does NOT merge __defaults__,
# so every option is spelled out here.
#
# WHAT THIS IS: a phone-friendly "Network Manager" page for a pwnagotchi you
# own - a searchable, 50+-scale list of the networks/targets you work with
# (wifi you join, fleet agents, wifi attack targets), with add/edit/delete, a
# current/selected marker, and a per-row FIRE TEST button. BACKBONE: the fire
# action is a clear per-kind stub for now; the real fires wire on top.

[main.plugins.netmanager_ng]
enabled = false

# ---------------------------------------------------------------------
# >>> USER INPUT REQUIRED <<<
# ---------------------------------------------------------------------
# No working default. Blank/placeholder/<12 chars => the server refuses to
# start. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
auth_token = ""

# Exposure. "auto" (tailscale IP if present, else 127.0.0.1), "tailscale"
# (require tailscale or refuse), "localhost", or "lan" (0.0.0.0 - explicit,
# logged, broad). The exact URL is always logged. Default to the least-exposed
# scope that reaches your phone (lan on a home network you trust; tailscale is
# more private).
bind_scope = "auto"
port = 8085

# Where the network list is stored (0600 - may hold fleet tokens).
store_path = "/etc/pwnagotchi/netmanager_ng/networks.json"

# Per-fire network timeout in seconds (e.g. the fleet reachability probe).
fire_timeout_seconds = 10

# Bulk-import sources (so you never hand-type 50+). Import is deduped + additive.
handshakes_dir = "/etc/pwnagotchi/handshakes"
fleet_json_path = "/home/pi/.config/fleetctl/fleet.json"

# ---------------------------------------------------------------------
# NON-NEGOTIABLE GATE: a wifi_target "fire" is REFUSED unless the target's
# BSSID or SSID is listed here. EMPTY by default - nothing can be fired at.
# Only add networks you OWN or are AUTHORIZED to test. Manage it the easy way:
#   sudo /etc/pwnagotchi/netmanager_ng/netmanagerctl.sh authorize <BSSID|SSID>
# ---------------------------------------------------------------------
authorized_targets = []

# =====================================================================
# wifi_target CAPTURE BACKEND (the authorized-path "real test").
# OFF by default. This is a SECOND switch ON TOP of the allowlist above:
# even for an authorized target, nothing is captured/sent unless BOTH
# capture_backend_enabled=true AND capture_iface names a SECOND adapter.
# It runs standard tools (airodump-ng capture locked to the one authorized
# BSSID + an optional bounded, targeted aireplay-ng deauth) and drops the
# handshake into your handshakes dir. Only against networks you own or are
# authorized to test - same rule as the allowlist.
#   Requirements: a 2nd monitor-mode USB adapter + aircrack-ng installed.
#   Find the adapter: sudo /etc/pwnagotchi/netmanager_ng/netmanager_wifi_probe.sh
# =====================================================================
capture_backend_enabled = false
# >>> USER INPUT REQUIRED (when you enable the backend) <<<
# The SECOND adapter to capture on - NEVER the pwnagotchi radio (wlan0/wlan0mon).
# Run netmanager_wifi_probe.sh to find a monitor-capable one (e.g. "wlan1").
capture_iface = ""
capture_seconds = 25
# 0 = PASSIVE capture only (sends nothing). >0 = a bounded, targeted deauth to
# coax a handshake; hard-capped (a capture nudge, never a flood). Start at 0.
deauth_count = 0
# Where the .pcapng lands (empty -> handshakes_dir above).
capture_out_dir = ""
# Interfaces the backend will REFUSE to use (the pwnagotchi/bettercap radio).
builtin_ifaces = ["wlan0", "wlan0mon", "mon0"]

# On-screen status (optional; shows the network count on the TFT).
ui_enabled = true
ui_position_x = -40
ui_position_y = 30
